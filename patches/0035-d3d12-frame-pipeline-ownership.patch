+/* Command lists do not retain their PSOs. Pins last until the next GPU fence. */
+static ID3D12PipelineState* s_frame_psos[MAX_DRAWS];
+static void vp_store_frame_pso(u32 draw, ID3D12PipelineState* pso)
+{
+    if (draw >= MAX_DRAWS) return;
+    if (pso) pso->lpVtbl->AddRef(pso);
+    ID3D12PipelineState* old = s_frame_psos[draw];
+    s_frame_psos[draw] = pso;
+    if (old) old->lpVtbl->Release(old);
+}
+
+static void vp_release_frame_psos(void)
+{
+    for (u32 draw = 0; draw < MAX_DRAWS; ++draw) {
+        if (s_frame_psos[draw]) s_frame_psos[draw]->lpVtbl->Release(s_frame_psos[draw]);
+        s_frame_psos[draw] = NULL;
+    }
+}
