+    return vp_get_fp_pso(dr->vs_idx, dr->fp_addr, blend, dr_num_rts(dr),
+        dr->rt_off ? rsx_surface_dxgi(dr->rt_fmt) : DXGI_FORMAT_R8G8B8A8_UNORM,
+        dr->fp_exp32, dr->cmask, dr->cull, dr_cube_mask(dr), dr->depth_key,
+        alpha, dr->depth_bias, dr->slope_bias);
+}
