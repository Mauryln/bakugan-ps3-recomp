-    if (!s_gcm_kick_ev) s_gcm_kick_ev = CreateEventA(NULL, FALSE, FALSE, NULL);
-    return (void*)s_gcm_kick_ev;
+    HANDLE event = (HANDLE)InterlockedCompareExchangePointer(
+        (PVOID volatile*)&s_gcm_kick_ev, NULL, NULL);
