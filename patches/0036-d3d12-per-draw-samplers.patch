+/* Complete sampler tables stay immutable until the frame fence. A heap may
+ * contain at most 2048 samplers; additional pages cover even unique draws. */
+#define SAMPLER_TABLES_PER_PAGE (2048 / RSX_MAX_TEXTURES)
+#define SAMPLER_MAX_PAGES ((MAX_DRAWS + SAMPLER_TABLES_PER_PAGE - 1) / SAMPLER_TABLES_PER_PAGE)
+static struct {
+    ID3D12DescriptorHeap* heap;
+    u32 count;
+    D3D12_SAMPLER_DESC tables[SAMPLER_TABLES_PER_PAGE][RSX_MAX_TEXTURES];
+} s_sampler_pages[SAMPLER_MAX_PAGES];
+static u32 s_sampler_inc;
+
+static D3D12_TEXTURE_ADDRESS_MODE rsx_sampler_wrap(u32 wrap)
+{
+    switch (wrap & 15u) {
+    case 1: return D3D12_TEXTURE_ADDRESS_MODE_WRAP;
+    case 2: return D3D12_TEXTURE_ADDRESS_MODE_MIRROR;
+    case 4: return D3D12_TEXTURE_ADDRESS_MODE_BORDER;
+    case 6: case 7: case 8: return D3D12_TEXTURE_ADDRESS_MODE_MIRROR_ONCE;
+    default: return D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    }
+}
+
+/* GCM field layout shared with the live draw backend. Extended CLAMP and
+ * MIRROR modes use D3D's edge approximation; convolution uses linear. */
+static D3D12_SAMPLER_DESC rsx_sampler_desc(u32 address, u32 filter, u32 control, u32 border)
+{
+    D3D12_SAMPLER_DESC d = {0};
+    u32 minf = (filter >> 16) & 7u, magf = (filter >> 24) & 7u;
+    D3D12_FILTER_TYPE mn = (minf == 2 || minf == 4 || minf == 6 || minf == 7)
+        ? D3D12_FILTER_TYPE_LINEAR : D3D12_FILTER_TYPE_POINT;
+    D3D12_FILTER_TYPE mg = (magf == 2 || magf == 4)
+        ? D3D12_FILTER_TYPE_LINEAR : D3D12_FILTER_TYPE_POINT;
+    D3D12_FILTER_TYPE mp = minf >= 5 ? D3D12_FILTER_TYPE_LINEAR : D3D12_FILTER_TYPE_POINT;
+    d.Filter = D3D12_ENCODE_BASIC_FILTER(mn, mg, mp, D3D12_FILTER_REDUCTION_TYPE_STANDARD);
+    d.AddressU = rsx_sampler_wrap(address);
+    d.AddressV = rsx_sampler_wrap(address >> 8);
+    d.AddressW = rsx_sampler_wrap(address >> 16);
+    d.MinLOD = (float)((control >> 19) & 0xFFFu) / 256.0f;
+    d.MaxLOD = minf >= 3 ? (float)((control >> 7) & 0xFFFu) / 256.0f : 0.0f;
+    if (d.MaxLOD < d.MinLOD) d.MaxLOD = d.MinLOD;
+    int bias = (int)(filter & 0x1FFFu); /* signed 5.8 fixed point */
+    if (bias & 0x1000) bias -= 0x2000;
+    d.MipLODBias = (float)bias / 256.0f;
+    d.MaxAnisotropy = 1;
+    d.ComparisonFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+    d.BorderColor[0] = (float)((border >> 16) & 255u) / 255.0f;
+    d.BorderColor[1] = (float)((border >> 8) & 255u) / 255.0f;
+    d.BorderColor[2] = (float)(border & 255u) / 255.0f;
+    d.BorderColor[3] = (float)((border >> 24) & 255u) / 255.0f;
+    return d;
+}
+
+/* Called after wait_for_gpu, before opening the next command list. */
+static int rsx_prepare_samplers(void)
+{
+    for (u32 p = 0; p < SAMPLER_MAX_PAGES; ++p) s_sampler_pages[p].count = 0;
+    s_sampler_inc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER);
+    u32 page = 0;
+    for (u32 i = 0; i < s_d3d.draw_count && i < MAX_DRAWS; ++i) {
+        D3D12DrawRecord* dr = &s_d3d.draws[i];
+        if (!dr->is_vp || dr->is_clear) continue;
+        D3D12_SAMPLER_DESC table[RSX_MAX_TEXTURES];
+        for (u32 u = 0; u < RSX_MAX_TEXTURES; ++u) {
+            table[u] = rsx_sampler_desc(0x30303u, 0x01012000u, 0, 0);
+            if (dr->tex[u].set && (dr->sampled_units & (1u << u)))
+                table[u] = rsx_sampler_desc(dr->tex[u].sampler_address,
+                    dr->tex[u].sampler_filter, dr->tex[u].sampler_control, dr->tex[u].sampler_border);
+        }
+        u32 slot;
+        for (slot = 0; slot < s_sampler_pages[page].count; ++slot)
+            if (!memcmp(table, s_sampler_pages[page].tables[slot], sizeof(table))) break;
+        if (slot == SAMPLER_TABLES_PER_PAGE) { ++page; slot = 0; }
+        if (!s_sampler_pages[page].heap) {
+            D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+            hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+            hd.NumDescriptors = 2048;
+            hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+            HRESULT hr = s_d3d.device->lpVtbl->CreateDescriptorHeap(s_d3d.device, &hd,
+                &IID_ID3D12DescriptorHeap, (void**)&s_sampler_pages[page].heap);
+            if (FAILED(hr)) {
+                fprintf(stderr, "[D3D12] sampler heap allocation failed (0x%08lX)\n", hr);
+                return 0;
+            }
+        }
+        if (slot == s_sampler_pages[page].count) {
+            D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+            s_sampler_pages[page].heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_sampler_pages[page].heap, &cpu);
+            cpu.ptr += (size_t)slot * RSX_MAX_TEXTURES * s_sampler_inc;
+            for (u32 u = 0; u < RSX_MAX_TEXTURES; ++u) {
+                s_d3d.device->lpVtbl->CreateSampler(s_d3d.device, &table[u], cpu);
+                cpu.ptr += s_sampler_inc;
+            }
+            memcpy(s_sampler_pages[page].tables[slot], table, sizeof(table));
+            ++s_sampler_pages[page].count;
+        }
+        dr->sampler_table = page * SAMPLER_TABLES_PER_PAGE + slot;
+    }
+    return 1;
+}
